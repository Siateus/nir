fun main(): void {
    var a: int = 4;
    var b: int = 7;

    if (a == b) {
        print("igual");
    } else {
        print("diferente");
    }

    if (a != b) {
        print("a != b");
    }
    if (a < b) {
        print("a < b");
    }
    if (b > a) {
        print("b > a");
    }
    if (a <= 4) {
        print("a <= 4");
    }
    if (b >= 7) {
        print("b >= 7");
    }
}

// Saida esperada:
// diferente
// a != b
// a < b
// b > a
// a <= 4
// b >= 7
