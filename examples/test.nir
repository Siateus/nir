fun main(): void {
    var item: int = 15;
    var passos: int = 0;

    do {
        // Se for divisível por 3 e 5 ao mesmo tempo (operador lógico &&)
        if (item % 3 == 0 && item % 5 == 0) {
            print("FizzBuzz:");
            print(item);
        } else {
            if (item % 3 == 0) {
                print("Fizz:");
                print(item);
            }
        }
        
        item = item - 1;
        passos = passos + 1;
    } while (item > 0 && passos < 10);
    
    print("Ciclo encerrado no item:");
    print(item);
}
