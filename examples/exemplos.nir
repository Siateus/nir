var float:f32;  //ponto flutuante de precisão simples
var c:char; # comentario
var double:f64; //ponto flutuante de precisão dupla
var int:i32; #comentario 
/* O perigo: Motores de regex tentam casar as alternativas da 
 esquerda para a direita. Se no seu código fonte aparecer ==, >= ou <=, dependendo da 
 ordem interna ou de como a string for varrida, o motor pode casar apenas o primeiro 
 = como um caractere individual da lista, deixando o segundo = solto para virar outro 
 token inválido. */


fun add(a: i32, b: i32 ): i32 {
	return a + b;
}

fun main(): void{
	var a: i32 = 3;
	var b: i32 = 3;
  var r: i32 = add(a,b);
  print(r);
  print(add(10,2));
  var str: string = "Olá mundo";
  for(var i: i32 = 0 ; i < 3) {
      print(i+1);
  }

}
