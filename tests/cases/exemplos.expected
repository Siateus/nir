Nome do Arquivo examples/exemplos.nir
-> PROG
  -> VAR_DECL (float)
    -> TYPE (f32)
  -> VAR_DECL (c)
    -> TYPE (char)
  -> VAR_DECL (double)
    -> TYPE (f64)
  -> VAR_DECL (int)
    -> TYPE (i32)
  -> FUN_DECL (add)
    -> TYPE (i32)
    -> PARAM (a)
      -> TYPE (i32)
    -> PARAM (b)
      -> TYPE (i32)
    -> BLOCK
      -> RETURN
        -> BIN_OP (+)
          -> ID (a)
          -> ID (b)
  -> FUN_DECL (main)
    -> TYPE (void)
    -> BLOCK
      -> VAR_DECL (a)
        -> TYPE (i32)
        -> NUMBER (3)
      -> VAR_DECL (b)
        -> TYPE (i32)
        -> NUMBER (3)
      -> VAR_DECL (r)
        -> TYPE (i32)
        -> CALL (add)
          -> ID (a)
          -> ID (b)
      -> PRINT
        -> ID (r)
      -> PRINT
        -> CALL (add)
          -> NUMBER (10)
          -> NUMBER (2)
      -> VAR_DECL (str)
        -> TYPE (string)
        -> STRING ("Olá mundo")
      -> FOR
        -> VAR_DECL (i)
          -> TYPE (i32)
          -> NUMBER (0)
        -> BIN_OP (<)
          -> ID (i)
          -> NUMBER (3)
        -> BLOCK
          -> PRINT
            -> BIN_OP (+)
              -> ID (i)
              -> NUMBER (1)
