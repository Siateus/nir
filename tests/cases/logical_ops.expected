Nome do Arquivo examples/logical_ops.nir
-> PROG
  -> FUN_DECL (test_logic)
    -> TYPE (void)
    -> PARAM (a)
      -> TYPE (i32)
    -> PARAM (b)
      -> TYPE (i32)
    -> BLOCK
      -> VAR_DECL (cond1)
        -> TYPE (i32)
        -> NUMBER (0)
      -> IF
        -> BIN_OP (||)
          -> BIN_OP (&&)
            -> BIN_OP (>)
              -> ID (a)
              -> NUMBER (0)
            -> BIN_OP (>)
              -> ID (b)
              -> NUMBER (0)
          -> UN_OP (!)
            -> BIN_OP (==)
              -> ID (a)
              -> ID (b)
        -> BLOCK
          -> PRINT
            -> NUMBER (1)
        -> BLOCK
          -> PRINT
            -> NUMBER (0)
  -> FUN_DECL (main)
    -> TYPE (void)
    -> BLOCK
      -> CALL (test_logic)
        -> NUMBER (1)
        -> NUMBER (2)
